<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 개발 빌드에서만 현재 HTTP 개발 서버와 Metro 연결을 허용합니다. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
